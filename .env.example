# Home Assistant Configuration
HASS_URL=https://fitz.itspartyti.me
HASS_TOKEN=your_long_lived_access_token_here
PERSON_ENTITY=person.cam

# Server Configuration
PORT=8080
# Interface to listen on. Empty = all interfaces; use 127.0.0.1 behind a local reverse proxy.
# BIND_ADDR=127.0.0.1
CACHE_TTL_SECONDS=15
# Dashboard password. Leave empty to disable password login entirely.
ADMIN_PASSWORD=

# Optional: comma-separated IPs/CIDRs of reverse proxies (e.g. Authelia) allowed to
# authenticate via the Remote-User header and supply client IPs. Empty = trust none.
# TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16

# Optional: Comma-separated list of pub zone entity IDs (leave empty for auto-detection by icon)
# PUB_ZONES=zone.the_vic,zone.foreigner,zone.the_grandview,zone.the_union
